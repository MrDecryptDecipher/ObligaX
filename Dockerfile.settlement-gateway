# ==========================================
# ObligaX Settlement Gateway Server
# Multi-stage, non-root (UID 10003)
# ==========================================

FROM node:26-alpine AS builder

WORKDIR /build

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma/

RUN npm ci

COPY backend ./backend/
RUN npm run build
RUN npm prune --production

FROM node:26-alpine AS runner

LABEL org.opencontainers.image.title="ObligaX Settlement Gateway" \
      org.opencontainers.image.description="External Banking Rails & RTGS Simulator Gateway" \
      org.opencontainers.image.vendor="ObligaX Network"

ENV NODE_ENV=production \
    SETTLEMENT_GATEWAY_PORT=5020 \
    APP_USER=obligax \
    APP_UID=10003

RUN addgroup -g ${APP_UID} ${APP_USER} && \
    adduser -u ${APP_UID} -G ${APP_USER} -s /sbin/nologin -D ${APP_USER}

WORKDIR /app

COPY --chown=${APP_USER}:${APP_USER} --from=builder /build/dist ./dist
COPY --chown=${APP_USER}:${APP_USER} --from=builder /build/node_modules ./node_modules
COPY --chown=${APP_USER}:${APP_USER} --from=builder /build/package*.json ./

USER ${APP_USER}

EXPOSE 5020

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5020/health || exit 1

ENTRYPOINT ["node", "dist/backend/src/infrastructure/settlement/settlement-gateway.js"]
